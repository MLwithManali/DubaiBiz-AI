.turbo/
.parcel-cache/

# FuseBox
.fusebox/

# TernJS
.tern-port/


# ==========================================
# 15. TEMPORARY FILES
# ==========================================

*.tmp
*.temp
*.bak
*.orig

tmp/
temp/


# ==========================================
# 16. FILES TO KEEP IN GITHUB
# ==========================================

# Keep these important project files:
#
# README.md
# package.json
# package-lock.json
# tsconfig.json
# prisma7.config.ts
# server/prisma/schema.prisma
# server/prisma/migrations/
