
# ==========================================
# DubaiBiz AI - Git Ignore Configuration
# ==========================================
# Stack:
# React + TypeScript + Vite
# Node.js + Express
# PostgreSQL + Prisma
# Python + FastAPI
# ==========================================


# ==========================================
# 1. NODE.JS DEPENDENCIES
# ==========================================

node_modules/
jspm_packages/
bower_components/
web_modules/

# Package manager caches
.npm/
.pnpm-store/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Yarn integrity
.yarn-integrity

# npm package archives
*.tgz


# ==========================================
# 2. ENVIRONMENT VARIABLES & SECRETS
# ==========================================

# Ignore environment files in all folders
.env
.env.*
**/.env
**/.env.*

# Allow example environment configurations
!.env.example
!**/.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Local credentials
credentials.json
service-account.json
secrets.json


# ==========================================
# 3. LOG FILES
# ==========================================

logs/
*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Node diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json


# ==========================================
# 4. NODE.JS RUNTIME FILES
# ==========================================

pids/
*.pid
*.seed
*.pid.lock

# REPL history
.node_repl_history

# Native compiled addons
build/Release/

# Node lock script
.lock-wscript


# ==========================================
# 5. TYPESCRIPT
# ==========================================

*.tsbuildinfo

# TypeScript build output
dist/
build/

# Preserve source files
!src/


# ==========================================
# 6. REACT + VITE
# ==========================================

.vite/
**/.vite/

# Vite temporary files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# React build output
client/dist/

# Local development caches
.cache/
.parcel-cache/


# ==========================================
# 7. NEXT.JS / NUXT / OTHER FRAMEWORKS
# ==========================================

.next/
out/

.nuxt/
.output/

.svelte-kit/
.astro/

.docusaurus/

.vuepress/dist/
.temp/

**/.vitepress/dist/
**/.vitepress/cache/


# ==========================================
# 8. PRISMA + POSTGRESQL
# ==========================================

# Keep Prisma schema and migrations tracked
# server/prisma/schema.prisma
# server/prisma/migrations/

# Local database dumps and backups
*.sql.gz
*.dump
*.backup

# Generated Prisma client
server/src/generated/prisma/

# Prisma temporary cache
.prisma/


# ==========================================
# 9. PYTHON + FASTAPI
# ==========================================

# Python virtual environments
.venv/
venv/
env/
ENV/

# AI service virtual environment
ai-service/.venv/
ai-service/venv/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Python test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Python coverage
.coverage
.coverage.*
htmlcov/

# Python build artifacts
*.egg-info/
.eggs/
*.whl

# Python packaging
pip-wheel-metadata/

# Python local databases
*.sqlite3

# Python notebook checkpoints
.ipynb_checkpoints/


# ==========================================
# 10. AI / MACHINE LEARNING ARTIFACTS
# ==========================================

# Temporary training checkpoints
checkpoints/
training_runs/

# Large model files
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.onnx

# Temporary ML outputs
tensorboard/
wandb/
mlruns/

# Local datasets
datasets/
raw_data/

# Note:
# Track small approved model artifacts separately
# if needed for reproducibility.


# ==========================================
# 11. TESTING & COVERAGE
# ==========================================

coverage/
*.lcov
.nyc_output/

# Grunt
.grunt/

# JavaScript coverage output
lib-cov/


